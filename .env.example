# ==============================================================================
# PyRedis Cluster & Microservices Master Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Control Plane Database
# ------------------------------------------------------------------------------
POSTGRES_DB=pyredis
POSTGRES_USER=pyredis
POSTGRES_PASSWORD=pyredis_secure_password
POSTGRES_PORT=5432

# In Docker / production container network:
# DATABASE_URL=postgresql+asyncpg://pyredis:pyredis_secure_password@pyredis-postgres:5432/pyredis
# When accessing from host machine:
# DATABASE_URL=postgresql+asyncpg://pyredis:pyredis_secure_password@localhost:5432/pyredis
# If left empty/unset, PyRedis automatically falls back to local SQLite: ./data/pyredis_control.db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. PyRedis Engine & Server
# ------------------------------------------------------------------------------
PORT=6379
HOST=0.0.0.0
API_PORT=8000
API_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 3. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=supersecret-pyredis-production-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Provider (DBA Diagnostics & Vector Embeddings)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# 5. Memory Management & Eviction
# ------------------------------------------------------------------------------
# MAX_MEMORY_BYTES: 256MB default = 268435456
MAX_MEMORY_BYTES=268435456
# EVICTION_POLICY: noeviction | allkeys_lru | volatile_lru | allkeys_lfu | volatile_lfu | volatile_ttl | adaptive
EVICTION_POLICY=noeviction

# ------------------------------------------------------------------------------
# 6. Persistence & Durability
# ------------------------------------------------------------------------------
AOF_ENABLED=true
# AOF_FSYNC_POLICY: always | everysec | no
AOF_FSYNC_POLICY=everysec
AOF_PATH=./data/appendonly.aof
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SEC=300
SNAPSHOT_PATH=./data/dump.rdb

# ------------------------------------------------------------------------------
# 7. Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
SLOW_QUERY_THRESHOLD_MS=5.0

# ------------------------------------------------------------------------------
# 8. Web Management Console (Client Dashboard)
# ------------------------------------------------------------------------------
DASHBOARD_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=PyRedis
NEXT_PUBLIC_APP_ENV=development
