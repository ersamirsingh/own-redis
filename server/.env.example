# ==============================================================================
# PyRedis Server Configuration (.env.example)
# ==============================================================================

# Network & Server Ports
PORT=6379
HOST=0.0.0.0
API_PORT=8000
API_HOST=0.0.0.0

# Authentication & Security
JWT_SECRET=supersecret-pyredis-production-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Control Plane Database
# PostgreSQL connection string for user accounts, RBAC, API keys, and audit logs.
# If left empty, PyRedis automatically falls back to local SQLite at ./data/pyredis_control.db
# When running with Docker Compose: postgresql://pyredis:pyredis_secure_password@localhost:5432/pyredis
DATABASE_URL=

# Google Gemini AI Provider (DBA Diagnostics & Vector Embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Memory & Eviction Management
# MAX_MEMORY_BYTES: Maximum memory in bytes before eviction triggers (default: 256MB = 268435456)
MAX_MEMORY_BYTES=268435456
# EVICTION_POLICY: noeviction | allkeys_lru | volatile_lru | allkeys_lfu | volatile_lfu | volatile_ttl | adaptive
EVICTION_POLICY=noeviction

# Persistence & Storage
AOF_ENABLED=true
# AOF_FSYNC_POLICY: always | everysec | no
AOF_FSYNC_POLICY=everysec
AOF_PATH=./data/appendonly.aof
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SEC=300
SNAPSHOT_PATH=./data/dump.rdb

# Observability & Logging
LOG_LEVEL=INFO
SLOW_QUERY_THRESHOLD_MS=5.0

