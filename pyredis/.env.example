# Network & Server Ports
PORT=6379
HOST=0.0.0.0
API_PORT=8000
API_HOST=0.0.0.0

# Authentication & Security
JWT_SECRET=supersecret-pyredis-production-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini AI Provider (optional default/fallback, overridable in Settings UI)
GEMINI_API_KEY=

# Persistence & Storage
AOF_ENABLED=true
AOF_FSYNC_POLICY=everysec
AOF_PATH=./data/appendonly.aof
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_SEC=300
SNAPSHOT_PATH=./data/dump.rdb

# Observability & Logging
LOG_LEVEL=INFO
SLOW_QUERY_THRESHOLD_MS=5.0
